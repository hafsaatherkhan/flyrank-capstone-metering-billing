# Database connection strings (Neon PostgreSQL, pooled connection required with sslmode=require)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL_TEST=postgresql://user:password@ep-sample-test-pooler.region.neon.tech/neondb_test?sslmode=require

# App settings
APP_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
CRON_SECRET=sample_cron_secret_change_me
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# Database Pool Settings (Neon PgBouncer / Connection Pooler)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# Polar credentials (sandbox mode only)
POLAR_ACCESS_TOKEN=polar_oat_xxx
POLAR_WEBHOOK_SECRET=xxx
POLAR_PRO_PRODUCT_ID=xxx
POLAR_SERVER=sandbox

# Background Job & Retry Configuration
RECONCILE_MAX_RETRIES=3
RECONCILE_BACKOFF_BASE=0.5
RECONCILE_BACKOFF_MAX=5.0
RECONCILE_REQUEST_TIMEOUT=5.0
ALERT_WEBHOOK_URL=

# SMTP Configuration (Gmail or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="HisaabLedger"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
